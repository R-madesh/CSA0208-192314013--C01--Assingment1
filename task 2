#include <stdio.h>
#include <limits.h>
typedef unsigned short meter_t;
// Calculate units including meter rollover
unsigned int consumption(meter_t previous,
                         meter_t current)
{
    return (unsigned short)(current - previous);
}
int main()
{
    printf("TASK 2 \n");

    // Display data type sizes
    printf("Size of char = %zu bytes\n", sizeof(char));
    printf("Size of int = %zu bytes\n", sizeof(int));
    printf("Size of long = %zu bytes\n", sizeof(long));
    printf("Size of long long = %zu bytes\n", sizeof(long long));
    printf("Size of float = %zu bytes\n", sizeof(float));
    printf("Size of double = %zu bytes\n", sizeof(double));
    // Meter size and maximum value
    printf("\nMeter size = %zu bytes\n", sizeof(meter_t));
    printf("Maximum reading = %hu\n", USHRT_MAX);

    // Normal consumption
    printf("\nConsumption: %u units\n",
           consumption(1200, 1530));

    // Meter rollover
    printf("Consumption: %u units\n",
           consumption(65400, 120));

    // Money calculation in paise
    long long bill = 16250;

    printf("\nElectricity Bill = Rs. %lld.%02lld\n",
           bill / 100, bill % 100);

    return 0;
}
