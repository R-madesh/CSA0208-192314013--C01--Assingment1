 #include <stdio.h>

// Define macros safely
#define RUPEES_TO_PAISE(x) ((x) * 100)
#define MAX(a, b) ((a) > (b) ? (a) : (b))
#define SQUARE(x) ((x) * (x))

int main()
{
    int rupees = 50;
    int a = 20, b = 30;
    int num = 5;

    printf("===== TASK 4 =====\n");

    // Convert rupees to paise
    printf("Rupees to Paise = %d\n",
           RUPEES_TO_PAISE(rupees));

    // Find maximum number
    printf("Maximum Number = %d\n",
           MAX(a, b));

    // Find square
    printf("Square = %d\n",
           SQUARE(num));

    // Demonstrate parentheses
    printf("Square of 5+1 = %d\n",
           SQUARE(num + 1));
    return 0;
}
